{
  "expo": {
    "name": "Time Table",
    "slug": "campus-connect-timetable",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cctimetable",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#070B18"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070B18"
      },
      "package": "com.campusconnect.timetable",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "SmallTimetableWidget",
              "label": "Timetable (Next Class)",
              "minWidth": "160dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "description": "Ongoing and next class"
            },
            {
              "name": "BigTimetableWidget",
              "label": "Timetable (Full Day)",
              "minWidth": "270dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "updatePeriodMillis": 1800000,
              "description": "Today's complete class schedule"
            },
            {
              "name": "MiniGridTimetableWidget",
              "label": "Timetable Grid (4x5)",
              "minWidth": "250dp",
              "minHeight": "310dp",
              "targetCellWidth": 4,
              "targetCellHeight": 5,
              "updatePeriodMillis": 1800000,
              "description": "Today's classes in a compact 2-column grid (4x5)"
            },
            {
              "name": "GridTimetableWidget4x6",
              "label": "Timetable Grid (4x6)",
              "minWidth": "250dp",
              "minHeight": "380dp",
              "targetCellWidth": 4,
              "targetCellHeight": 6,
              "updatePeriodMillis": 1800000,
              "description": "Today's complete classes in a 2-column grid (4x6)"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ac518f1-e42f-4fa5-abf4-f375f54defa9"
      }
    },
    "owner": "omkumar_1234",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6ac518f1-e42f-4fa5-abf4-f375f54defa9"
    }
  }
}
